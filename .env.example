# Copy to .env to override compose defaults (optional)
# cp .env.example .env
#
# Production: ./compose up --build        (or podman compose up --build)
# Development: ./compose-dev up --build   (hot reload, bind mounts)
#
# Change JWT_SECRET before exposing the production stack beyond localhost.
# Dev compose accepts a shorter JWT_SECRET (8+ chars); production requires 32+.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=moneymesh

# Host ports — intentionally uncommon to avoid conflicts
POSTGRES_HOST_PORT=25432
BACKEND_HOST_PORT=23000
FRONTEND_HOST_PORT=25173

JWT_SECRET=local-compose-only-jwt-secret-min-32-chars
